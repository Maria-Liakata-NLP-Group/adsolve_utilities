# Evaluation API configuration.
# Copy to .env and fill in. .env is gitignored; this file is not, so keep it free
# of real secrets.
#
#   cp .env.example .env
#   uvicorn evaluation_api.app:app --factory --port 8000
#
# A real exported environment variable overrides anything set here.

# Required. Callers send it as the X-Api-Token header.
# If unset, every authenticated route returns 503 rather than serving openly.
METRIC_API_TOKEN=

# Where per-job input files, generated scripts and results are written.
METRIC_JOB_ROOT=./job_data

# SQLite job store.
METRIC_DB_PATH=./jobs.db

# Kill a bundle subprocess after this long. Default 21600 (6 hours).
METRIC_JOB_TIMEOUT_SECONDS=21600

# Delete job rows and directories this long after they finish. Default 168 (7 days).
METRIC_RETENTION_HOURS=168

# Isolated metric environments, one URL per environment: METRIC_ENV_<NAME>_URL.
# Leave unset and green_score reports available=false and is rejected at submit.
# METRIC_ENV_GREENSCORE_URL=http://greenscore:8000
