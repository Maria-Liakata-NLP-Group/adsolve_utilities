# Cluster settings for the Kubeflow drivers.
#
#   cp .env.example .env    # then fill in; .env is gitignored
#
# These identify your cluster and account and rarely change. Per-run settings
# (JOB_NAME, metrics, input/output paths) stay in the driver, since those are
# what you edit for each experiment.
#
# A real exported environment variable overrides anything set here.

# Kubeflow namespace. Yours, not the example's -- this is the setting that
# differs between users on the shared cluster.
KF_NAMESPACE=kf-XXXXXX

# Shared filesystem: the PVC name and where it is mounted in the pod.
# s3_credentials.json is expected at the root of this mount.
KF_CLAIMNAME=XXXXXX-shared-fs
KF_MOUNTPATH=/home/jovyan/XXXXXX-shared-fs

# Image in Harbor, built from evaluation_bundles/Dockerfile.
KF_IMAGE=harbor.a.comp-teach.qmul.ac.uk/nlp/adsolve-eval:latest

# Where this repo sits on the shared filesystem. The image supplies the
# environment; the code is read from here, so edits need no image rebuild.
KF_REPO_DIR=/home/jovyan/XXXXXX-shared-fs/adsolve_utilities

# Kueue LocalQueue to submit into. Leave EMPTY when your namespace has none
# (check with: kubectl -n <ns> get localqueues). The label is what opts a job
# into Kueue; naming a queue that does not exist in your namespace leaves the
# job suspended forever. Set to nlp once a LocalQueue exists here.
KF_QUEUE=

# GPU flavour: nvidia.com/a40 or nvidia.com/h100-96g
KF_GPU_RESOURCE=nvidia.com/a40

# HuggingFace cache staged from S3 into /tmp/models. Leave EMPTY to skip
# staging entirely and let models download from HuggingFace instead.
KF_S3_MODELS=s3://nlp-01/adsolve/hf_models

# 1 = fail fast on a cache miss; 0 = allow downloads at runtime.
# Set to 0 for the first run, before the S3 cache has been populated.
KF_HF_OFFLINE=1

# Ceph RGW endpoint. The default matches the in-cluster service.
# KF_S3_ENDPOINT=http://rook-ceph-rgw-ceph-objectstore-private.rook-ceph.svc.cluster.local
